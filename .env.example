# =============================================================================
# SUNWINKR CASINO PLATFORM - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git. NEVER use the default passwords below.
# Generate strong passwords with: openssl rand -base64 32
# =============================================================================

# === Compose project (SUN-1023) ===
# Pins the Docker Compose project name to "sunwinkr" regardless of which
# directory compose is invoked from. Without this, a bare `docker compose up`
# from a renamed/cloned dir labels containers with the wrong project,
# orphaning them and blocking `./start.sh` recovery (2026-04-21 outage).
# DO NOT CHANGE.
COMPOSE_PROJECT_NAME=sunwinkr

# === Database ===
MYSQL_USER=sunwinkr_user
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD_1
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_2
MONGO_USER=sunwinkr_admin
MONGO_PASSWORD=CHANGE_ME_STRONG_PASSWORD_3
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_4
# === Redis Streams (RMQ → Redis Streams migration; SUN-RS) ===
# Keep stream traffic on a separate logical DB from the cache (DB 0) so a
# FLUSHDB or accidental KEYS scan on the cache can't touch durable work-queue
# state. Auth re-uses REDIS_PASSWORD — same Redis instance, different DB.
# MESSAGE_BUS_DEFAULT is the routing sentinel read by MessageBusFactory:
#   rmq    = legacy path (current default during dual-write soak / S1)
#   redis  = Redis Streams path
# Per-queue overrides take precedence over this default.
REDIS_STREAMS_HOST=redis
REDIS_STREAMS_PORT=6379
REDIS_STREAMS_PASSWORD=${REDIS_PASSWORD}
REDIS_STREAMS_DB=1
MESSAGE_BUS_DEFAULT=rmq
RABBITMQ_USER=sunwinkr_rmq
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_PASSWORD_5
HAZELCAST_GROUP=sunwinkr
HAZELCAST_PASSWORD=CHANGE_ME_STRONG_PASSWORD_6

# === API & Auth ===
API_AUTH_SECRET=CHANGE_ME_GENERATE_NEW_TOKEN
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_7
WEBHOOK_SECRET=CHANGE_ME_STRONG_PASSWORD_8
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_ALLOWED_IPS=91.108.6.0/24,149.154.160.0/20

# === Encryption ===
DES_LEGACY_KEY=KEEP_OLD_DES_KEY_FOR_MIGRATION
AES_ENCRYPTION_KEY=CHANGE_ME_GENERATE_32_BYTE_HEX
KEYSTORE_PASSWORD=CHANGE_ME_STRONG_PASSWORD_9
BANCA_CERT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_10
TOTP_ENCRYPTION_KEY=CHANGE_ME_GENERATE_32_BYTE_HEX_FOR_AES256

# === Game Control (house edge / rigging flags) ===
GAME_FORCE_ENABLED=true
XOCDIA_DEFAULT_FORCE_TYPE=-1
XOCDIA_FORCE_ENABLED=true
BOT_FUND_MANIPULATION_ENABLED=true
BOT_AUTO_JOIN_ENABLED=true
BOT_DEFAULT_BALANCE=1000000
SLOT_RTP_PERCENTAGE=48
TAIXIU_HOUSE_EDGE_ENABLED=true
BANCA_JACKPOT_CONTROL_ENABLED=true
BANCA_HACK_ENFORCE=false
REDIS_COMMAND_SECRET=CHANGE_ME_STRONG_PASSWORD_11

# === App Config ===
APP_ENV=production
APP_DEBUG=false
ALLOWED_IP_RANGES=172.16.0.0/12
PASSWORD_RESET_TOKEN_EXPIRY=3600
TZ=Asia/Ho_Chi_Minh

# === Game Server Admin (shared across all 16 game servers) ===
GAME_ADMIN_USER=sunwinkr_admin
GAME_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_12

# === Service URLs (Docker service names for inter-container communication) ===
API_BACKEND_URL=http://backend-api:19082/api_backend
API_PORTAL_URL=http://portal-api:8081/api
API_AGENT_URL=http://backend-api:19082/api_agent

# === Payment Gateways ===
COINPAYMENTS_PUBLIC_KEY=YOUR_KEY_HERE
COINPAYMENTS_PRIVATE_KEY=YOUR_KEY_HERE
MOMO_SECRET=YOUR_KEY_HERE
ONECLICKPAY_MERCHANT=YOUR_MERCHANT_HERE
ONECLICKPAY_KEY=YOUR_KEY_HERE
GACHTHE_API_KEY=YOUR_KEY_HERE
ESMS_API_KEY=YOUR_KEY_HERE
ESMS_SECRET=YOUR_KEY_HERE
SMS_API_KEY=YOUR_KEY_HERE
SMS_API_SECRET=YOUR_KEY_HERE

# === Email/SMTP ===
SMTP_EMAIL=YOUR_EMAIL_HERE
SMTP_PASSWORD=YOUR_PASSWORD_HERE

# === Lottery ===
LOTTERY_SCRAPE_URL=https://az24.vn/xsmb-sxmb-xo-so-mien-bac.html

# === Telegram Deposit Bot ===
TELEGRAM_DEPOSIT_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# =============================================================================
# GSC+ Game Aggregator (env-driven — switch staging/prod by editing these)
# =============================================================================
# Portal API (VinPlayPortal) reads these for c=3090 (launch game) and
# c=3091 (game list). Changing values requires only a container restart.
#
# Staging defaults (fallback if unset):
#   GSC_OPERATOR_URL=https://staging.gsimw.com
#   GSC_OPERATOR_CODE=G7A1
#   GSC_SECRET_KEY=abYVbCrLT2VwpASotZGmCT
#   GSC_LOBBY_URL=https://staging-play.sunkr.bet
#   GSC_CURRENCY=IDR2
# =============================================================================
GSC_OPERATOR_URL=https://staging.gsimw.com
GSC_OPERATOR_CODE=G7A1
GSC_SECRET_KEY=YOUR_GSC_SECRET_KEY
GSC_LOBBY_URL=https://staging-play.sunkr.bet
GSC_CURRENCY=IDR2

# --- Per-product currency overrides (optional) ---
# Some providers use a different currency from the account default.
# Example: on operator G7A1 (KRW account), PG Soft is only enabled as KRW2.
# Format: "PRODUCT_CODE:CURRENCY,PRODUCT_CODE:CURRENCY,..."
# Leave empty if all products use the default GSC_CURRENCY.
GSC_CURRENCY_PER_PRODUCT=

# --- Game catalog filtering (optional) ---
# Comma-separated. Leave empty to show all activated games.
#   strict  = only games in WHITELIST_PRODUCTS ∪ WHITELIST_GAMES are returned
#   feature = all activated games returned; whitelisted ones get featured:true
GSC_WHITELIST_MODE=feature
GSC_WHITELIST_PRODUCTS=
GSC_WHITELIST_GAMES=
# SUN-1373: when true, bets on games with gsc_game_catalog.active=0 are rejected
# at the wallet-debit layer with errorCode 0011 / GAME_INACTIVE so the FE can
# show a "table closed" popup. Set to true on staging; default false (off) for
# safety on new deploys where catalog may not yet have the active column.
GSC_BET_WHITELIST_ENFORCE=true

# =============================================================================
# AWC (Asia Win Connect) Game Aggregator — second third-party provider
# =============================================================================
# Seamless wallet integration. AWC calls back to our server for every wallet
# event (bet, settle, cancel, etc.). Kill switch: AWC_ENABLED=0 (default OFF).
#
# Staging defaults (fallback if unset):
#   AWC_AGENT_ID=lime01
#   AWC_CERT=PigVq2D07hNL
#   AWC_PREFIX=lime
#   AWC_API_URL=https://awc-api.apihub888.com
#   AWC_CURRENCY=VND
# =============================================================================
AWC_ENABLED=0
AWC_AGENT_ID=lime01
AWC_CERT=YOUR_AWC_CERT
AWC_PREFIX=lime
AWC_API_URL=https://awc-api.apihub888.com
AWC_CALLBACK_URL=https://staging-play.sunkr.bet/awc/callback
AWC_CURRENCY=VND
AWC_LANGUAGE=en

TELEGRAM_DEPOSIT_CHAT_ID=YOUR_CHAT_ID_HERE

# =============================================================================
# BanCa commission bridge (SUN-1054)
# =============================================================================
# BanCa (C# .NET, own currency) POSTs session-end events to
# backend-api c=9854 LogBetCommission, which calls RealTimeCommission
# the same way LogMoneyUserExtraProcessor does for Java games.
# Shared secret is required on every request via X-Service-Token header.
# BANCA_COMMISSION_ENABLED default 0 = audit-only (endpoint records the
# event but does NOT credit agents). Flip to 1 after product signs off on
# the commission basis (SUN-1054).
# =============================================================================
BANCA_SERVICE_TOKEN=CHANGE_ME_BANCA_SERVICE_TOKEN
BANCA_COMMISSION_ENABLED=0

# =============================================================================
# Spring minigame-api + lottery-api feature flags (TaiXiu / Sicbo / XSMB)
# =============================================================================
# Default OFF in .env.example for safe ramp. The Dockerfile ENV defaults set
# MINIGAME_API_ENABLED=1 / LOTTERY_API_ENABLED=1 so the Spring boot context
# starts inside the container even when the per-host .env hasn't been refreshed.
#
# The BitZero bridge flags (MINIGAME_API_BRIDGE_ENABLED, MINIGAME_ENGINE_ENABLED,
# MINIGAME_ENGINE_GHOST_MODE, LOTTERY_ENGINE_ENABLED, LOTTERY_ENGINE_GHOST_MODE)
# must stay OFF until the engine-coexistence soak passes — see
# docs/plans/taixiu-extraction-plan.md §1.4 and docs/plans/lottery-extraction-plan.md §1.4.
#
# Compose service names (NOT 1:1 with the env var prefix):
#   minigame-api          → sunwinkr-minigame-api          (REST 9290 / mgmt 9291)
#   lottery-spring-api    → sunwinkr-lottery-spring-api    (REST 9292 / mgmt 9293)
# The legacy Node XSMB scraper service in docker-compose.lottery.yml still owns
# the `lottery-api` / `sunwinkr-lottery-api` names on port 49111.
# =============================================================================
MINIGAME_API_ENABLED=0
MINIGAME_API_PUSH_ENABLED=0
MINIGAME_API_BRIDGE_ENABLED=0
MINIGAME_ENGINE_ENABLED=0
MINIGAME_ENGINE_GHOST_MODE=0
LOTTERY_API_ENABLED=0
LOTTERY_ENGINE_ENABLED=0
LOTTERY_ENGINE_GHOST_MODE=0
LOTTERY_SHADOW_DIFF_ENABLED=0
LOTTERY_MODE5_LEGACY_3OF4=0

#STAGING_SSH_PASSWORD=paste-current-staging-ssh-password
