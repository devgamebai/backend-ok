[mysqld]
max_connections=1000000

# Binlog retention — 3 days (staging has no replica, PITR need is minimal).
# Default was 30 days which accumulated ~100 binlog files (~100 GB) on 2026-04-11.
# 259200s = 3 days. Increase if a replica is added later.
binlog_expire_logs_seconds=259200

# 2026-05-08: bump from default 1G → 4G to avoid OOM at 2G cgroup ceiling.
# Container memory limit raised from 2G → 8G in docker-compose.database.yml
# at the same time. Buffer pool at 50% of container limit leaves 4G for
# connection pool, log buffer, sort/temp, and per-thread workspace —
# standard MySQL tuning ratio.
innodb_buffer_pool_size = 4G

# Number of buffer pool instances. With 4G pool, 4 instances × 1G each
# distributes mutex contention better than the default single instance.
# Recommended formula: pool_size_GB ≤ instances ≤ 8.
innodb_buffer_pool_instances = 4

# Durability — relaxed from the OOTB defaults (innodb_flush_log_at_trx_commit=1,
# sync_binlog=1) which fsync the redo log AND the binlog on every commit
# and cause the "waiting for handler commit" tail we hit. Standard
# high-throughput OLTP setting; trades "lose ≤1 second of committed
# transactions if the host hardware dies" for ~5-10× faster commits.
# MySQL crash recovery is unaffected — InnoDB still rebuilds from the
# redo log; only a host-level power loss can lose the last second.
innodb_flush_log_at_trx_commit = 2
sync_binlog = 100

# IO capacity. Default 200 assumes a single spinning HDD. Production
# storage is SSD/NVMe; this lets InnoDB push more pages through the
# background flush + dirty-page cleaner threads.
innodb_io_capacity = 2000

# Lock wait timeout. Default 50s means a blocked statement hangs 50s
# before returning an error — which feeds the GSC client's 10s HTTP
# timeout and causes ghost-debit retries. Failing fast at 10s lets
# the caller surface "service busy" while we're still inside the
# typical RTO window.
innodb_lock_wait_timeout = 10