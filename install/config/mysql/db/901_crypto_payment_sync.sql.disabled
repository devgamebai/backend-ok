-- Migration: Create processed_events table and add missing columns for crypto payment sync
-- Required by: CryptoDepositEventProcessor, CryptoWithdrawalEventProcessor (RMQ consumers)

USE vinplay;

-- Idempotency table for RabbitMQ event processing (zero transaction loss)
CREATE TABLE IF NOT EXISTS processed_events (
    id INT AUTO_INCREMENT PRIMARY KEY,
    event_id VARCHAR(100) NOT NULL,
    event_type VARCHAR(50) NOT NULL,
    processed_at DATETIME DEFAULT NOW(),
    UNIQUE KEY uk_event_id (event_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- Add missing columns to crypto_withdrawals if they don't exist
-- tx_hash: on-chain transaction hash from the gateway on completion
-- fail_reason: failure reason from the gateway on failure
ALTER TABLE crypto_withdrawals ADD COLUMN tx_hash VARCHAR(128) DEFAULT NULL;
ALTER TABLE crypto_withdrawals ADD COLUMN fail_reason VARCHAR(512) DEFAULT NULL;
