<?xml version="1.0"?>
<hook>
    <port>9591</port>
    <games>
        <game>
            <path_root>/gsc/v1</path_root>
            <name>GSC Seamless Wallet API v1.1.4</name>
            <whitelist>
                <ip>127.0.0.1</ip>
                <ip>192.168.0.102</ip>
                <ip>localhost</ip>
                <ip>0:0:0:0:0:0:0:1</ip>
                <ip>*</ip>
            </whitelist>
            <paths>
                <path>
                    <pattern>/api/seamless/balance</pattern>
                    <name>balance</name>
                    <process>game.third.hooks.gscSeamless.BalanceProcess</process>
                </path>
                <path>
                    <pattern>/api/seamless/withdraw</pattern>
                    <name>withdraw</name>
                    <process>game.third.hooks.gscSeamless.WithdrawProcess</process>
                </path>
                <path>
                    <pattern>/api/seamless/deposit</pattern>
                    <name>deposit</name>
                    <process>game.third.hooks.gscSeamless.DepositProcess</process>
                </path>
                <path>
                    <pattern>/api/seamless/transfer</pattern>
                    <name>transfer</name>
                    <process>game.third.hooks.gscSeamless.TransferProcess</process>
                </path>
                <path>
                    <pattern>/api/seamless/rollback</pattern>
                    <name>rollback</name>
                    <process>game.third.hooks.gscSeamless.RollbackProcess</process>
                </path>
                <path>
                    <pattern>/api/seamless/cancel</pattern>
                    <name>cancel</name>
                    <process>game.third.hooks.gscSeamless.CancelProcess</process>
                </path>
                <path>
                    <pattern>/api/seamless/pushbet</pattern>
                    <name>pushbet</name>
                    <process>game.third.hooks.gscSeamless.PushBetProcess</process>
                </path>
                <path>
                    <pattern>/api/seamless/pushbetdata</pattern>
                    <name>pushbetdata</name>
                    <process>game.third.hooks.gscSeamless.PushBetProcess</process>
                </path>
            </paths>
        </game>
    </games>
</hook>
